// Tau AI CFO — PostgreSQL persistence schema.
//
// Design rules (see docs/BUILD_BRIEF.md):
//  * Every money column is NUMERIC(19,4). The application layer only ever sees DecimalString.
//  * Calendar dates (ISODate) are DATE; timestamps (ISODateTime) are TIMESTAMPTZ(3).
//  * audit_events is append-only: no updatedAt, insert-only trigger in prisma/rls.sql.
//  * Structured sub-documents that are never queried relationally are JSON (payroll lines,
//    budget/forecast lines, approval action/risk, calc inputs/values).
//  * Cross-entity "soft" references (journalEntryId on a transaction, documentIds, ...) are
//    plain indexed columns so engines may upsert entities in any order; the hard FKs are the
//    ledger core (journal_lines → journal_entries/accounts, journal_entries → periods) and
//    the owned child tables (invoice_lines, sessions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

