# ---- Tau AI CFO: environment configuration ----
# Persistence: "memory" (default; synthetic lab data, snapshot to .tau/) or "postgres"
TAU_STORE=memory
DATABASE_URL=postgresql://tau:tau@localhost:5432/tau_cfo

# Model providers (optional). With none configured, the deterministic local provider is used.
# Never commit real keys. Never put keys in prompts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
TAU_REASONING_MODEL=claude-opus-5
TAU_FAST_MODEL=claude-haiku-4-5
TAU_VERIFICATION_MODEL=claude-opus-5
TAU_MODEL_PROVIDER=auto   # auto | anthropic | openai | local

# Security
TAU_SESSION_SECRET=change-me-in-production   # full mode: if unset, a random secret is persisted to .tau/session-secret
TAU_AUTH_MODE=lab          # lab (single owner session) | full. Unset = full once .tau/users.json has a user, else lab
TAU_USERS_FILE=            # override the user directory path (default .tau/users.json); tests point this at a temp dir

# Lab
TAU_SYNTHETIC_SEED=20260101
TAU_AS_OF_DATE=2026-09-09
